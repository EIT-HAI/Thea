# Model provider: choose one provider and keep only its required secret.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MIMO_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# Optional process-level override. Prefer selecting the provider in config.yaml.
# LLM_PROVIDER=openai

# Trusted local Harness configuration.
LARK_HARNESS_CONFIG=./config.yaml

# Feishu/Lark application.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_ALLOWED_OPEN_IDS=
LARK_BOT_OPEN_ID=
LARK_REGION=cn

# Webhook trust anchors. WebSocket deployments may leave these empty unless
# the app configuration also uses them.
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=
LARK_WEBHOOK_MAX_SKEW_SEC=300

# Optional deployment factory: module:callable.
LARK_HARNESS_FACTORY=

# Safe process-local defaults.
LARK_DEPLOYMENT_MAX_CONCURRENCY=1
LARK_MAX_SESSIONS=64
LARK_SESSION_TTL_SEC=21600
LARK_QUERY_USER_TIMEOUT_SEC=300
LARK_QUERY_USER_MAX_IMAGES=8
LARK_RENDERING_MODE=auto
LARK_RUN_LOG_DIR=
LARK_IMAGE_ALLOWED_ROOT=
LARK_ALLOW_REMOTE_IMAGES=0
LARK_IMAGE_ALLOWED_HOSTS=
LARK_IMAGE_MAX_BYTES=10485760
LARK_IMAGE_MAX_PIXELS=20000000
LARK_HTTP_TIMEOUT_SEC=15
LARK_HTTP_RETRIES=3
LARK_HTTP_CONNECT_RETRIES=2
LARK_HTTP_PROXY=
